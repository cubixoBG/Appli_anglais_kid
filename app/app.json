{
  "expo": {
    "name": "Mon voyage",
    "slug": "monvoyage",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "La reconnaissance vocale sert à vérifier ta prononciation.",
        "NSMicrophoneUsageDescription": "Le micro sert à écouter ta prononciation. Rien n’est enregistré."
      },
      "bundleIdentifier": "fr.morganbonne.monvoyage",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2A4D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "fr.morganbonne.monvoyage"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Le micro sert à écouter ta prononciation. Rien n’est enregistré.",
          "speechRecognitionPermission": "La reconnaissance vocale sert à vérifier ta prononciation."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-image",
      "expo-audio"
    ],
    "owner": "oktopod",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "d216eef1-5d85-41d0-9776-688cde40354b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/d216eef1-5d85-41d0-9776-688cde40354b"
    }
  }
}
